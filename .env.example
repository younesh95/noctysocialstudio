# Secrets — configurez-les dans l’hébergeur, jamais dans le navigateur.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Modèles optionnels (les valeurs ci-dessous sont aussi les valeurs par défaut).
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
